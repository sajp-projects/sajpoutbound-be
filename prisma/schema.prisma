generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  performedLogs UserLog[] @relation("PerformedLogs")
  userLogs      UserLog[] @relation("UserLogs")

  @@index([roleId], map: "User_roleId_fkey")
}

model UserLog {
  id            String      @id @default(uuid())
  userId        String
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedLogs", fields: [performedById], references: [id])
  user          User        @relation("UserLogs", fields: [userId], references: [id])

  @@index([performedById], map: "UserLog_performedById_fkey")
  @@index([userId], map: "UserLog_userId_fkey")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum ENTITY_TYPE {
  USER
  ROLE
}
