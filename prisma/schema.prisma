generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String?
  password          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  roleId            String?
  warehouseId       String?
  expiresAt         DateTime?
  refreshToken      String?            @db.Text
  armadaLogs        ArmadaLog[]        @relation("PerformedArmadaLogs")
  customerLogs      CustomerLog[]      @relation("PerformedCustomerLogs")
  deliveryOrderLogs DeliveryOrderLog[] @relation("PerformedDeliveryOrderLogs")
  productLogs       ProductLog[]       @relation("PerformedProductLogs")
  shipmentLogs      ShipmentLog[]      @relation("PerformedShipmentLogs")
  role              Role?              @relation(fields: [roleId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  performedLogs     UserLog[]          @relation("PerformedLogs")
  userLogs          UserLog[]          @relation("UserLogs")
  warehouseLogs     WarehouseLog[]     @relation("PerformedWarehouseLogs")
  generatedSPMBs    SPMB[]             @relation("GeneratedSPMBs")

  @@index([roleId], map: "User_roleId_fkey")
  @@index([warehouseId], map: "User_warehouseId_fkey")
}

model UserLog {
  id            String      @id @default(uuid())
  userId        String
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedLogs", fields: [performedById], references: [id])
  user          User        @relation("UserLogs", fields: [userId], references: [id])

  @@index([performedById], map: "UserLog_performedById_fkey")
  @@index([userId], map: "UserLog_userId_fkey")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String?
  resource        String
  action          PERMISSION_ACTION
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermission[]

  @@unique([resource, action], name: "permission_resource_action")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "role_permission_unique")
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model Warehouse {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      Product[]
  shipmentItems ShipmentItem[]
  users         User[]
  warehouseLogs WarehouseLog[]
  spmbs         SPMB[]
}

model WarehouseLog {
  id            String      @id @default(uuid())
  warehouseId   String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedWarehouseLogs", fields: [performedById], references: [id])
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])

  @@index([performedById], map: "WarehouseLog_performedById_fkey")
  @@index([warehouseId], map: "WarehouseLog_warehouseId_fkey")
}

model Product {
  id                 String                  @id @default(uuid())
  name               String
  description        String?
  warehouseId        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  id_sl              String?                 @unique
  satuan             String
  deliveryOrderItems DeliveryOrderItem[]
  warehouse          Warehouse               @relation(fields: [warehouseId], references: [id])
  productLogs        ProductLog[]
  chosenProducts     ShipmentChosenProduct[]
  shipmentItems      ShipmentItem[]

  @@index([warehouseId], map: "Product_warehouseId_fkey")
}

model ProductLog {
  id            String      @id @default(uuid())
  productId     String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedProductLogs", fields: [performedById], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])

  @@index([performedById], map: "ProductLog_performedById_fkey")
  @@index([productId], map: "ProductLog_productId_fkey")
}

model Customer {
  id             String          @id @default(uuid())
  name           String          @unique
  id_sl          String?         @unique
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customerLogs   CustomerLog[]
  deliveryOrders DeliveryOrder[]
}

model CustomerLog {
  id            String      @id @default(uuid())
  customerId    String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  customer      Customer?   @relation(fields: [customerId], references: [id])
  performedBy   User        @relation("PerformedCustomerLogs", fields: [performedById], references: [id])

  @@index([performedById], map: "CustomerLog_performedById_fkey")
  @@index([customerId], map: "CustomerLog_customerId_fkey")
}

model Armada {
  id          String      @id @default(uuid())
  model       String
  id_sl       String?     @unique
  plateNumber String?     @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  armadaLogs  ArmadaLog[]
  shipments   Shipment[]
}

model Driver {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  shipments Shipment[]
}

model ArmadaLog {
  id            String      @id @default(uuid())
  armadaId      String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  armada        Armada?     @relation(fields: [armadaId], references: [id])
  performedBy   User        @relation("PerformedArmadaLogs", fields: [performedById], references: [id])

  @@index([performedById], map: "ArmadaLog_performedById_fkey")
  @@index([armadaId], map: "ArmadaLog_armadaId_fkey")
}

model DeliveryOrder {
  id              String              @id @default(uuid())
  doNumber        String?             @unique
  customerId      String
  address         String?
  internalNote    String?
  deliverySchedule DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?
  status          STATUS              @default(PENDING)
  customer        Customer            @relation(fields: [customerId], references: [id])
  items           DeliveryOrderItem[]
  doLogs          DeliveryOrderLog[]
  spmbs           SPMB[]
  shipmentItems   ShipmentItem[]

  @@index([customerId], map: "DeliveryOrder_customerId_fkey")
}

model DeliveryOrderItem {
  id                 String        @id @default(uuid())
  deliveryOrderId    String
  productId          String
  quantity           Float         @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedQuantity  Float         @default(0)
  pendingQuantity    Float         @default(0)
  processingQuantity Float         @default(0)
  cancelledQuantity  Float         @default(0)
  deliveryOrder      DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])

  @@index([deliveryOrderId], map: "DeliveryOrderItem_deliveryOrderId_fkey")
  @@index([productId], map: "DeliveryOrderItem_productId_fkey")
}

model DeliveryOrderLog {
  id              String         @id @default(uuid())
  deliveryOrderId String?
  performedById   String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  action          ACTION
  entityType      ENTITY_TYPE
  oldData         Json?
  newData         Json?
  description     String?
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])
  performedBy     User           @relation("PerformedDeliveryOrderLogs", fields: [performedById], references: [id])

  @@index([performedById], map: "DeliveryOrderLog_performedById_fkey")
  @@index([deliveryOrderId], map: "DeliveryOrderLog_deliveryOrderId_fkey")
}

model Shipment {
  id             String                  @id @default(uuid())
  shipmentNumber String?                 @unique
  type           SHIPMENT_TYPE           @default(ANTAR)
  status         STATUS                  @default(PENDING)
  armadaId       String?
  driverId       String?
  tally          String?
  kenek          String?
  internalNote   String?
  plateNumber    String?
  platePhoto     String?
  isVerified     Boolean                 @default(false)
  verifiedAt     DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  preWeighingWeight   Float?
  preWeighingAt       DateTime?
  preWeighingById     String?
  postWeighingWeight     Float?
  postWeighingAt         DateTime?
  postWeighingById       String?
  isPreWeighingManual    Boolean  @default(false)
  preWeighingManualReason String?
  isPostWeighingManual   Boolean  @default(false)
  postWeighingManualReason String?
  spmbs          SPMB[]
  armada         Armada?                 @relation(fields: [armadaId], references: [id])
  driver         Driver?                @relation(fields: [driverId], references: [id])
  chosenProducts ShipmentChosenProduct[]
  shipmentItems  ShipmentItem[]
  shipmentLogs   ShipmentLog[]

  @@index([armadaId], map: "Shipment_armadaId_fkey")
  @@index([driverId], map: "Shipment_driverId_fkey")
}

model ShipmentItem {
  id                              String                         @id @default(uuid())
  shipmentId                      String
  deliveryOrderId                 String
  productId                       String
  requestedQuantity               Float                          @default(0)
  weightedQuantity                Float?
  status                          SHIPMENT_ITEM_STATUS           @default(PENDING)
  warehouseId                     String
  weighedAt                       DateTime?
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt
  chosenProduct                   Boolean                        @default(false)
  locationType                    String?
  loadingGroupId                  String?
  shipmentChosenProductWeighingId String?
  deliveryOrder                   DeliveryOrder                  @relation(fields: [deliveryOrderId], references: [id])
  product                         Product                        @relation(fields: [productId], references: [id])
  shipment                        Shipment                       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  warehouse                       Warehouse                      @relation(fields: [warehouseId], references: [id])
  weighing                        ShipmentChosenProductWeighing? @relation(fields: [shipmentChosenProductWeighingId], references: [id])

  @@index([shipmentId], map: "ShipmentItem_shipmentId_fkey")
  @@index([deliveryOrderId], map: "ShipmentItem_deliveryOrderId_fkey")
  @@index([productId], map: "ShipmentItem_productId_fkey")
  @@index([warehouseId], map: "ShipmentItem_warehouseId_fkey")
  @@index([shipmentChosenProductWeighingId], map: "ShipmentItem_shipmentChosenProductWeighingId_fkey")
  @@index([loadingGroupId], map: "ShipmentItem_loadingGroupId_idx")
}

model SPMB {
  id              String        @id @default(uuid())
  shipmentId      String
  deliveryOrderId String
  warehouseId     String
  code            String        @unique
  displayCode     String?       @unique
  documentPath    String?
  generatedById   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  shipment        Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  generatedBy     User?         @relation("GeneratedSPMBs", fields: [generatedById], references: [id])

  @@unique([shipmentId, deliveryOrderId, warehouseId], name: "spmb_shipment_do_warehouse_unique")
  @@index([shipmentId], map: "SPMB_shipmentId_fkey")
  @@index([deliveryOrderId], map: "SPMB_deliveryOrderId_fkey")
  @@index([warehouseId], map: "SPMB_warehouseId_fkey")
  @@index([generatedById], map: "SPMB_generatedById_fkey")
}

model SpmbDailyCounter {
  warehouseCode String
  dateKey       String // YYMMDD (Jakarta time)
  seq           Int    @default(0)

  @@id([warehouseCode, dateKey])
}

model NotaTimbangan {
  id                              String                        @id @default(uuid())
  ticketNumber                    String                        @unique
  ticketSeq                       Int                           @unique @default(autoincrement())
  documentPath                    String?
  shipmentChosenProductWeighingId String                        @unique
  createdAt                       DateTime                      @default(now())
  updatedAt                       DateTime                      @updatedAt
  shipmentChosenProductWeighing   ShipmentChosenProductWeighing @relation(fields: [shipmentChosenProductWeighingId], references: [id], onDelete: Cascade)

  @@index([shipmentChosenProductWeighingId], map: "NotaTimbangan_shipmentChosenProductWeighingId_fkey")
}

model ShipmentLog {
  id            String      @id @default(uuid())
  shipmentId    String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedShipmentLogs", fields: [performedById], references: [id])
  shipment      Shipment?   @relation(fields: [shipmentId], references: [id])

  @@index([performedById], map: "ShipmentLog_performedById_fkey")
  @@index([shipmentId], map: "ShipmentLog_shipmentId_fkey")
}

model ShipmentChosenProduct {
  id             String                          @id @default(uuid())
  code           String                          @unique
  shipmentId     String
  productId      String
  weighingMethod WEIGHING_METHOD                 @default(MANUAL)
  createdAt      DateTime                        @default(now())
  updatedAt      DateTime                        @updatedAt
  product        Product                         @relation(fields: [productId], references: [id])
  shipment       Shipment                        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  weighings      ShipmentChosenProductWeighing[]

  @@unique([shipmentId, productId], name: "unique_shipment_do_product")
  @@index([shipmentId], map: "ShipmentChosenProduct_shipmentId_fkey")
  @@index([productId], map: "ShipmentChosenProduct_productId_fkey")
}

model ShipmentChosenProductWeighing {
  id                      String                @id @default(uuid())
  shipmentChosenProductId String
  grossWeight             Float
  netWeight               Float?
  tareWeight              Float?
  timeIn                  DateTime?
  timeOut                 DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  shipmentChosenProduct   ShipmentChosenProduct @relation(fields: [shipmentChosenProductId], references: [id])
  notaTimbangan           NotaTimbangan?
  shipmentItems           ShipmentItem[]

  @@index([shipmentChosenProductId], map: "ShipmentChosenProductWeighing_shipmentChosenProductId_fkey")
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum ENTITY_TYPE {
  USER
  ROLE
  PERMISSION
  WAREHOUSE
  PRODUCT
  CUSTOMER
  ARMADA
  DRIVER
  DELIVERY_ORDER
  SHIPMENT
  SPMB
}

enum PERMISSION_ACTION {
  CREATE
  READ
  UPDATE
  DELETE
  WEIGH
  VERIFY_PLATE
  VERIFY_PLATE_MANUAL
  CHANGE_CUSTOMER
  REVISE_DO
  UNARCHIVE
  READ_ARCHIVED
  CHOSE_PRODUCT
  UPDATE_TALLY
  UPDATE_KENEK
  TRANSFER_ITEMS
  REDUCE_ITEMS
  CANCEL_ITEMS
  UPDATE_WEIGHING_METHOD
  MANUAL_WEIGHING_OVERRIDE
}

enum STATUS {
  PENDING
  PROSES
  SELESAI
  CANCEL
}

enum SHIPMENT_ITEM_STATUS {
  PENDING
  CHOSEN
  COMPLETED
  CANCELLED
}

enum SHIPMENT_TYPE {
  ANTAR
  JEMPUT
}

enum WEIGHING_METHOD {
  MANUAL
  VENDOR
}
