generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  roleId        String?
  warehouseId   String?        @unique
  role          Role?          @relation(fields: [roleId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  performedLogs UserLog[]      @relation("PerformedLogs")
  userLogs      UserLog[]      @relation("UserLogs")
  warehouseLogs WarehouseLog[] @relation("PerformedWarehouseLogs")
  productLogs   ProductLog[]   @relation("PerformedProductLogs")
  customerLogs  CustomerLog[]  @relation("PerformedCustomerLogs")

  @@index([roleId], map: "User_roleId_fkey")
}

model UserLog {
  id            String      @id @default(uuid())
  userId        String
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedLogs", fields: [performedById], references: [id])
  user          User        @relation("UserLogs", fields: [userId], references: [id])

  @@index([performedById], map: "UserLog_performedById_fkey")
  @@index([userId], map: "UserLog_userId_fkey")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String?
  resource        String
  action          PERMISSION_ACTION
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermission[]

  @@unique([resource, action], name: "permission_resource_action")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "role_permission_unique")
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model Warehouse {
  id            String         @id @default(uuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User?
  warehouseLogs WarehouseLog[]
  products      Product[]
}

model WarehouseLog {
  id            String      @id @default(uuid())
  warehouseId   String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedWarehouseLogs", fields: [performedById], references: [id])
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])

  @@index([performedById], map: "WarehouseLog_performedById_fkey")
  @@index([warehouseId], map: "WarehouseLog_warehouseId_fkey")
}

model Product {
  id            String         @id @default(uuid())
  name          String
  id_sl         String?         @unique
  description   String?
  warehouseId   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  productLogs   ProductLog[]

  @@index([warehouseId], map: "Product_warehouseId_fkey")
}

model ProductLog {
  id            String         @id @default(uuid())
  productId     String?
  performedById String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User           @relation("PerformedProductLogs", fields: [performedById], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])

  @@index([performedById], map: "ProductLog_performedById_fkey")
  @@index([productId], map: "ProductLog_productId_fkey")
}

model Customer {
  id            String         @id @default(uuid())
  name          String         @unique
  id_sl         String?         @unique
  address       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customerLogs  CustomerLog[]
}

model CustomerLog {
  id            String         @id @default(uuid())
  customerId    String?
  performedById String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User           @relation("PerformedCustomerLogs", fields: [performedById], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])

  @@index([performedById], map: "CustomerLog_performedById_fkey")
  @@index([customerId], map: "CustomerLog_customerId_fkey")
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum ENTITY_TYPE {
  USER
  ROLE
  PERMISSION
  WAREHOUSE
  PRODUCT
  CUSTOMER
}

enum PERMISSION_ACTION {
  CREATE
  READ
  UPDATE
  DELETE
}
