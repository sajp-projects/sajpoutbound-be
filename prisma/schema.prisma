generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String?
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  warehouseId   String?   @unique
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id])
  warehouseLogs WarehouseLog[] @relation("PerformedWarehouseLogs")
  performedLogs UserLog[] @relation("PerformedLogs")
  userLogs      UserLog[] @relation("UserLogs")

  @@index([roleId], map: "User_roleId_fkey")
}

model UserLog {
  id            String      @id @default(uuid())
  userId        String
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedLogs", fields: [performedById], references: [id])
  user          User        @relation("UserLogs", fields: [userId], references: [id])

  @@index([performedById], map: "UserLog_performedById_fkey")
  @@index([userId], map: "UserLog_userId_fkey")
}

model Role {
  id               String           @id @default(uuid())
  name             String           @unique
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  users            User[]
  rolePermissions  RolePermission[]
}

model Permission {
  id               String           @id @default(uuid())
  name             String           @unique
  description      String?
  resource         String
  action           PERMISSION_ACTION
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  rolePermissions  RolePermission[]

  @@unique([resource, action], name: "permission_resource_action")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "role_permission_unique")
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model Warehouse {
  id            String          @id @default(uuid())
  name          String
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  user          User?
  warehouseLogs WarehouseLog[]
}

model WarehouseLog {
  id            String      @id @default(uuid())
  warehouseId   String
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedWarehouseLogs", fields: [performedById], references: [id])
  warehouse     Warehouse   @relation(fields: [warehouseId], references: [id])

  @@index([performedById], map: "WarehouseLog_performedById_fkey")
  @@index([warehouseId], map: "WarehouseLog_warehouseId_fkey")
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum ENTITY_TYPE {
  USER
  ROLE
  PERMISSION
  WAREHOUSE
}

enum PERMISSION_ACTION {
  CREATE
  READ
  UPDATE
  DELETE
}
