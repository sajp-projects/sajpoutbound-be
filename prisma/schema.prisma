generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  name              String?
  password          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  roleId            String?
  warehouseId       String?
  role              Role?              @relation(fields: [roleId], references: [id])
  warehouse         Warehouse?         @relation(fields: [warehouseId], references: [id])
  performedLogs     UserLog[]          @relation("PerformedLogs")
  userLogs          UserLog[]          @relation("UserLogs")
  warehouseLogs     WarehouseLog[]     @relation("PerformedWarehouseLogs")
  productLogs       ProductLog[]       @relation("PerformedProductLogs")
  customerLogs      CustomerLog[]      @relation("PerformedCustomerLogs")
  armadaLogs        ArmadaLog[]        @relation("PerformedArmadaLogs")
  deliveryOrderLogs DeliveryOrderLog[] @relation("PerformedDeliveryOrderLogs")
  shipmentLogs      ShipmentLog[]      @relation("PerformedShipmentLogs")

  @@index([roleId], map: "User_roleId_fkey")
  @@index([warehouseId], map: "User_warehouseId_fkey")
}

model UserLog {
  id            String      @id @default(uuid())
  userId        String
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedLogs", fields: [performedById], references: [id])
  user          User        @relation("UserLogs", fields: [userId], references: [id])

  @@index([performedById], map: "UserLog_performedById_fkey")
  @@index([userId], map: "UserLog_userId_fkey")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String            @id @default(uuid())
  name            String            @unique
  description     String?
  resource        String
  action          PERMISSION_ACTION
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rolePermissions RolePermission[]

  @@unique([resource, action], name: "permission_resource_action")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], name: "role_permission_unique")
  @@index([permissionId], map: "RolePermission_permissionId_fkey")
}

model Warehouse {
  id            String         @id @default(uuid())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]
  warehouseLogs WarehouseLog[]
  products      Product[]
  shipmentItems ShipmentItem[]
}

model WarehouseLog {
  id            String      @id @default(uuid())
  warehouseId   String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedWarehouseLogs", fields: [performedById], references: [id])
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])

  @@index([performedById], map: "WarehouseLog_performedById_fkey")
  @@index([warehouseId], map: "WarehouseLog_warehouseId_fkey")
}

model Product {
  id                 String                  @id @default(uuid())
  name               String
  id_sl              String?                 @unique
  description        String?
  satuan             String // Unit of measurement (kg, m, ton, l, etc.)
  warehouseId        String
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  warehouse          Warehouse               @relation(fields: [warehouseId], references: [id])
  productLogs        ProductLog[]
  deliveryOrderItems DeliveryOrderItem[]
  shipmentItems      ShipmentItem[]
  chosenProducts     ShipmentChosenProduct[]

  @@index([warehouseId], map: "Product_warehouseId_fkey")
}

model ProductLog {
  id            String      @id @default(uuid())
  productId     String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedProductLogs", fields: [performedById], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])

  @@index([performedById], map: "ProductLog_performedById_fkey")
  @@index([productId], map: "ProductLog_productId_fkey")
}

model Customer {
  id             String          @id @default(uuid())
  name           String          @unique
  id_sl          String?         @unique
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customerLogs   CustomerLog[]
  deliveryOrders DeliveryOrder[]
}

model CustomerLog {
  id            String      @id @default(uuid())
  customerId    String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedCustomerLogs", fields: [performedById], references: [id])
  customer      Customer?   @relation(fields: [customerId], references: [id])

  @@index([performedById], map: "CustomerLog_performedById_fkey")
  @@index([customerId], map: "CustomerLog_customerId_fkey")
}

model Armada {
  id          String      @id @default(uuid())
  model       String
  id_sl       String?     @unique
  plateNumber String?     @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  armadaLogs  ArmadaLog[]
  shipments   Shipment[]
}

model ArmadaLog {
  id            String      @id @default(uuid())
  armadaId      String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedArmadaLogs", fields: [performedById], references: [id])
  armada        Armada?     @relation(fields: [armadaId], references: [id])

  @@index([performedById], map: "ArmadaLog_performedById_fkey")
  @@index([armadaId], map: "ArmadaLog_armadaId_fkey")
}

model DeliveryOrder {
  id             String                  @id @default(uuid())
  customerId     String
  address        String?
  internalNote   String?
  status         STATUS                  @default(PENDING)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  customer       Customer                @relation(fields: [customerId], references: [id])
  items          DeliveryOrderItem[]
  doLogs         DeliveryOrderLog[]
  shipmentItems  ShipmentItem[]
  spmbs          SPMB[]
  chosenProducts ShipmentChosenProduct[]

  @@index([customerId], map: "DeliveryOrder_customerId_fkey")
}

model DeliveryOrderItem {
  id                 String        @id @default(uuid())
  deliveryOrderId    String
  productId          String
  quantity           Int           @default(0)
  pendingQuantity    Int           @default(0)
  processingQuantity Int           @default(0)
  completedQuantity  Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deliveryOrder      DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  product            Product       @relation(fields: [productId], references: [id])

  @@index([deliveryOrderId], map: "DeliveryOrderItem_deliveryOrderId_fkey")
  @@index([productId], map: "DeliveryOrderItem_productId_fkey")
}

model DeliveryOrderLog {
  id              String         @id @default(uuid())
  deliveryOrderId String?
  performedById   String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  action          ACTION
  entityType      ENTITY_TYPE
  oldData         Json?
  newData         Json?
  description     String?
  performedBy     User           @relation("PerformedDeliveryOrderLogs", fields: [performedById], references: [id])
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])

  @@index([performedById], map: "DeliveryOrderLog_performedById_fkey")
  @@index([deliveryOrderId], map: "DeliveryOrderLog_deliveryOrderId_fkey")
}

model Shipment {
  id             String                  @id @default(uuid())
  type           SHIPMENT_TYPE           @default(ANTAR)
  status         STATUS                  @default(PENDING)
  armadaId       String? // Our armada, used for ANTAR type
  internalNote   String?
  plateNumber    String? // Manually input plate number for verification
  platePhoto     String? // Photo of plate number for verification
  isVerified     Boolean                 @default(false) // Flag for verification status
  verifiedAt     DateTime? // When the plate was verified
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  deletedAt      DateTime?
  armada         Armada?                 @relation(fields: [armadaId], references: [id])
  shipmentItems  ShipmentItem[]
  spmbs          SPMB[]
  shipmentLogs   ShipmentLog[]
  chosenProducts ShipmentChosenProduct[]

  @@index([armadaId], map: "Shipment_armadaId_fkey")
}

model ShipmentItem {
  id                String               @id @default(uuid())
  shipmentId        String
  deliveryOrderId   String
  productId         String
  requestedQuantity Int                  @default(0) // Total quantity from DO item
  weightedQuantity  Float? // Actual weight after weighing process
  status            SHIPMENT_ITEM_STATUS @default(PENDING)
  chosenProduct     Boolean              @default(false)
  warehouseId       String
  weighedAt         DateTime? // When the item was weighed
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  shipment          Shipment             @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  deliveryOrder     DeliveryOrder        @relation(fields: [deliveryOrderId], references: [id])
  product           Product              @relation(fields: [productId], references: [id])
  warehouse         Warehouse            @relation(fields: [warehouseId], references: [id])

  @@index([shipmentId], map: "ShipmentItem_shipmentId_fkey")
  @@index([deliveryOrderId], map: "ShipmentItem_deliveryOrderId_fkey")
  @@index([productId], map: "ShipmentItem_productId_fkey")
  @@index([warehouseId], map: "ShipmentItem_warehouseId_fkey")
}

model SPMB {
  id              String        @id @default(uuid())
  shipmentId      String
  deliveryOrderId String
  code            String        @unique // SPMB document code/number
  status          SPMB_STATUS   @default(PENDING)
  documentPath    String? // Optional URL/path to the stored PDF
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  shipment        Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])

  @@index([shipmentId], map: "SPMB_shipmentId_fkey")
  @@index([deliveryOrderId], map: "SPMB_deliveryOrderId_fkey")
}

model ShipmentLog {
  id            String      @id @default(uuid())
  shipmentId    String?
  performedById String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  action        ACTION
  entityType    ENTITY_TYPE
  oldData       Json?
  newData       Json?
  description   String?
  performedBy   User        @relation("PerformedShipmentLogs", fields: [performedById], references: [id])
  shipment      Shipment?   @relation(fields: [shipmentId], references: [id])

  @@index([performedById], map: "ShipmentLog_performedById_fkey")
  @@index([shipmentId], map: "ShipmentLog_shipmentId_fkey")
}

model ShipmentChosenProduct {
  id              String        @id @default(uuid())
  shipmentId      String
  deliveryOrderId String
  productId       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  shipment        Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([shipmentId, deliveryOrderId, productId], name: "unique_shipment_do_product")
  @@index([shipmentId], map: "ShipmentChosenProduct_shipmentId_fkey")
  @@index([deliveryOrderId], map: "ShipmentChosenProduct_deliveryOrderId_fkey")
  @@index([productId], map: "ShipmentChosenProduct_productId_fkey")
}

enum ACTION {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum ENTITY_TYPE {
  USER
  ROLE
  PERMISSION
  WAREHOUSE
  PRODUCT
  CUSTOMER
  ARMADA
  DELIVERY_ORDER
  SHIPMENT
  SPMB
}

enum PERMISSION_ACTION {
  CREATE
  READ
  UPDATE
  DELETE
}

enum STATUS {
  PENDING
  PROSES
  SELESAI
}

enum SHIPMENT_ITEM_STATUS {
  PENDING // Not yet weighed
  WEIGHING // In weighing process
  COMPLETED // Weighing completed
}

enum SPMB_STATUS {
  PENDING
  COMPLETED
}

enum SHIPMENT_TYPE {
  ANTAR // We use our own armada
  JEMPUT // Customer uses their own vehicle
}
